# ============================================================================
# StoryLine — Environment Variables
# ============================================================================
# Copy this file to backend/app/.env and fill in your values.

# Google Cloud Project ID (required)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud region for Vertex AI (required)
GOOGLE_CLOUD_LOCATION=us-central1

# Route GenAI calls through Vertex AI (required — leave as True)
GOOGLE_GENAI_USE_VERTEXAI=True

# Google Cloud Storage bucket name for generated media (required)
# Create this bucket in your GCP project before running
GENMEDIA_BUCKET=storyline-media-bucket

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Option A — Local development:
#   Run: gcloud auth application-default login
#   This stores credentials at ~/.config/gcloud/application_default_credentials.json
#
# Option B — Service account (production/Cloud Run):
#   Set: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================================
# REQUIRED GCP APIs (enable in Cloud Console)
# ============================================================================
# 1. Vertex AI API              — powers Gemini, Imagen, Veo, Lyria
# 2. Cloud Storage API           — media asset uploads
# 3. Generative Language API     — Gemini Live bidi-streaming
# ============================================================================
